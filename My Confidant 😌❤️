<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>For Oluwatosin</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        h1, h2, .serif-font {
            font-family: 'Playfair Display', serif;
        }
        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }
        .animate-float {
            animation: float 2.5s ease-in-out infinite;
        }
    </style>
</head>
<body class="bg-[#FAF7F2] text-[#2C2420] selection:bg-pink-200">

    <!-- HERO SECTION -->
    <section class="min-h-screen flex flex-col items-center justify-center text-center px-6 relative">
        <div class="text-xs tracking-[0.25em] uppercase text-[#8C7A70] mb-3 font-medium">for the one who changed everything</div>
        
        <h1 id="name-heading" class="text-5xl md:text-7xl font-bold tracking-tight text-[#1A1412] mb-4 cursor-pointer select-none transition-transform active:scale-95" title="Double tap Ur name, I dare you.">
            Oluwatosin
        </h1>
        
        <p class="text-sm md:text-base text-[#6B5C53] max-w-md mb-8 leading-relaxed">
            Every love story is beautiful, but ours is my favorite. Double tap Ur name, I dare you.
        </p>

        <div id="heart-container" class="h-8 mb-12"></div>

        <div class="absolute bottom-8 text-xs tracking-widest text-[#8C7A70] animate-float">
            scroll down ↓
        </div>
    </section>

    <!-- LETTER SECTION -->
    <section class="py-24 px-6 max-w-2xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-serif text-center mb-12 text-[#1A1412]">A Letter To You</h2>
        
        <div class="bg-white/70 backdrop-blur-sm p-8 md:p-12 rounded-2xl shadow-xs border border-[#EFECE6] space-y-6 text-[#4A3F38] leading-relaxed text-base md:text-lg">
            <p>
                Oluwatosin, I wanted to create this little corner of the internet just to tell you how much you truly mean to me. From the moment you walked into my life, you’ve brought a warmth and light that I never knew I was missing. You have this beautiful way of making even the simplest moments feel extraordinary just by being there.
            </p>
            <p>
                Thank you for being my constant safe haven, my biggest supporter, and my absolute favorite person. The love, care, and peace you give me every single day mean more to me than words could ever express. Loving you is the easiest, sweetest thing I have ever done.
            </p>
            <p>
                Thank you for being my man, my heart, and my best friend. I love you endlessly, today and always.
            </p>
        </div>
    </section>

    <!-- TEXT MEMORIES SECTION -->
    <section class="py-24 px-6 max-w-2xl mx-auto mb-20">
        <h2 class="text-3xl md:text-4xl font-serif text-center mb-12 text-[#1A1412]">Little Things I Love</h2>
        
        <div class="space-y-6">
            <div class="bg-white p-6 rounded-xl border border-[#EFECE6] text-center">
                <p class="font-serif text-lg text-[#1A1412] mb-2">Your Gentle Heart</p>
                <p class="text-sm text-[#6B5C53]">The way you love me so patiently, protect my peace, and always make me feel safe.</p>
            </div>

            <div class="bg-white p-6 rounded-xl border border-[#EFECE6] text-center">
                <p class="font-serif text-lg text-[#1A1412] mb-2">Our Laughs & Long Calls</p>
                <p class="text-sm text-[#6B5C53]">Every smile we share and every quiet moment together are memories I treasure most.</p>
            </div>

            <div class="bg-white p-6 rounded-xl border border-[#EFECE6] text-center">
                <p class="font-serif text-lg text-[#1A1412] mb-2">My Favorite Blessing</p>
                <p class="text-sm text-[#6B5C53]">Having you as my man is the greatest gift, and I’m so grateful to walk through life with you.</p>
            </div>
        </div>
    </section>

    <!-- JAVASCRIPT FOR DOUBLE-TAP INTERACTION -->
    <script>
        const nameHeading = document.getElementById('name-heading');
        const heartContainer = document.getElementById('heart-container');
        
        let lastTap = 0;

        nameHeading.addEventListener('click', function (e) {
            const currentTime = new Date().getTime();
            const tapLength = currentTime - lastTap;
            
            if (tapLength < 300 && tapLength > 0) {
                // Double tap detected!
                triggerLoveEffect();
                e.preventDefault();
            }
            lastTap = currentTime;
        });

        function triggerLoveEffect() {
            heartContainer.innerHTML = '<span class="text-rose-500 font-serif text-lg animate-pulse">❤️ Forever & Always ❤️</span>';
            setTimeout(() => {
                heartContainer.innerHTML = '';
            }, 3000);
        }
    </script>
</body>
</html>
